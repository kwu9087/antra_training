--19
SELECT
    c.CompanyName, -- Or c.ContactName if preferred
    o.OrderDate
FROM
    Customers AS c
JOIN
    Orders AS o ON c.CustomerID = o.CustomerID
WHERE
    o.OrderDate > '1998-01-01'
ORDER BY
    c.CompanyName,
    o.OrderDate;

--20
WITH RankedOrders AS (
    SELECT
        CustomerID,
        OrderDate,
        ROW_NUMBER() OVER(PARTITION BY CustomerID ORDER BY OrderDate DESC) as rn
    FROM Orders
)
SELECT
    c.CompanyName, -- Or c.ContactName
    ro.OrderDate AS MostRecentOrderDate
FROM
    Customers c
JOIN
    RankedOrders ro ON c.CustomerID = ro.CustomerID
WHERE
    ro.rn = 1
ORDER BY
    c.CompanyName;

--21
SELECT
    c.CompanyName, 
    ISNULL(SUM(od.Quantity), 0) AS TotalProductsBoughtrs
FROM
    Customers AS c
LEFT JOIN 
    Orders AS o ON c.CustomerID = o.CustomerID
LEFT JOIN
    "Order Details" AS od ON o.OrderID = od.OrderID
GROUP BY
    c.CustomerID, c.CompanyName 
ORDER BY
    c.CompanyName;

--22
SELECT
    c.CustomerID,
    SUM(od.Quantity) AS TotalProductsBought
FROM
    Customers AS c
JOIN
    Orders AS o ON c.CustomerID = o.CustomerID
JOIN
    "Order Details" AS od ON o.OrderID = od.OrderID
GROUP BY
    c.CustomerID
HAVING
    SUM(od.Quantity) > 100
ORDER BY
    c.CustomerID;

