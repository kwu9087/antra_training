--25
SELECT
    e1.FirstName + ' ' + e1.LastName AS Employee1,
    e2.FirstName + ' ' + e2.LastName AS Employee2,
    e1.Title
FROM
    Employees AS e1
JOIN
    Employees AS e2 ON e1.Title = e2.Title 
WHERE
    e1.EmployeeID < e2.EmployeeID
ORDER BY
    e1.Title,
    Employee1,
    Employee2;

--26
SELECT
    m.FirstName + ' ' + m.LastName AS ManagerName,
    COUNT(e.EmployeeID) AS NumberOfReports
FROM
    Employees AS e 
JOIN
    Employees AS m ON e.ReportsTo = m.EmployeeID 
GROUP BY
    m.EmployeeID, m.FirstName, m.LastName
HAVING
    COUNT(e.EmployeeID) > 2
ORDER BY
    ManagerName;

