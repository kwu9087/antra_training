--14
DECLARE @StartDate DATETIME = DATEADD(year, -27, GETDATE())

SELECT DISTINCT
    p.ProductName
FROM
    Products AS p
JOIN
    "Order Details" AS od ON p.ProductID = od.ProductID
JOIN
    Orders AS o ON od.OrderID = o.OrderID
WHERE
    o.OrderDate >= @StartDate -- Use the calculated start date
ORDER BY
    p.ProductName;

--15
SELECT TOP 5 
    o.ShipPostalCode,
    SUM(od.Quantity) AS TotalQuantitySold
FROM
    Orders AS o
JOIN
    "Order Details" AS od ON o.OrderID = od.OrderID
WHERE
    o.ShipPostalCode IS NOT NULL AND o.ShipPostalCode <> '' 
GROUP BY
    o.ShipPostalCode
ORDER BY
    TotalQuantitySold DESC;

--16
DECLARE @StartDate27 DATETIME = DATEADD(year, -27, GETDATE())

SELECT TOP 5 
    o.ShipPostalCode,
    SUM(od.Quantity) AS TotalQuantitySold
FROM
    Orders AS o
JOIN
    "Order Details" AS od ON o.OrderID = od.OrderID
WHERE
    o.OrderDate >= @StartDate27
    AND o.ShipPostalCode IS NOT NULL AND o.ShipPostalCode <> ''
GROUP BY
    o.ShipPostalCode
ORDER BY
    TotalQuantitySold DESC;

