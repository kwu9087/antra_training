--6
SELECT
    ProductID,
    SUM(Quantity) AS TheSum
FROM
    Production.ProductInventory
WHERE
    LocationID = 40
GROUP BY
    ProductID
HAVING
    SUM(Quantity) < 100
ORDER BY
    ProductID;

